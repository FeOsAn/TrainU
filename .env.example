# ── Required on any deployed instance ─────────────────────────────────────────

# The password for the single athlete this instance belongs to. Without it a
# deployed instance refuses to serve data at all, rather than serving a Garmin
# password and a full training history to anyone who finds the URL.
APP_PASSWORD=

# 32 random bytes as hex — `openssl rand -hex 32`. Encrypts third-party
# credentials at rest (Garmin password, Garmin session token, Whoop tokens).
# Without it, storing a credential in production throws rather than silently
# writing plaintext. CHANGING IT MAKES EXISTING STORED CREDENTIALS UNREADABLE,
# which means reconnecting Garmin/Whoop — it is not a rotation you can do
# casually.
CREDENTIAL_KEY=

# Where the SQLite file lives. On Railway this must point INSIDE a mounted
# volume or every deploy wipes the athlete's history. Defaults to
# /data/trainu.db in production, which matches a volume mounted at /data.
DB_PATH=/data/trainu.db

# ── Optional ──────────────────────────────────────────────────────────────────

# Without it the onboarding chat degrades to a "set ANTHROPIC_API_KEY" message
# rather than crashing. Everything else works.
ANTHROPIC_API_KEY=

# Whoop OAuth. Only needed if you connect Whoop. The redirect URI must match
# what's registered in the Whoop developer dashboard exactly, including https.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://your-app.up.railway.app/api/connectors/whoop/callback

# Signs the session cookie. Defaults to APP_PASSWORD, which is fine — set it
# only if you want to change the password without signing yourself out.
SESSION_SECRET=

# Garmin needs NO env vars: there's no OAuth for a hobbyist app, so you enter
# your Garmin email and password in the app itself and they're encrypted with
# CREDENTIAL_KEY before being stored.
